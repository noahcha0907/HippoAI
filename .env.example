# Copy to .env, which git ignores. Works with any OpenAI-compatible endpoint.

# Default fixer: Nemotron 3 Ultra on NVIDIA's API. NVIDIA_API also works in place of FIXER_API_KEY.
FIXER_BASE_URL=https://integrate.api.nvidia.com/v1
FIXER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
FIXER_API_KEY=
FIXER_CONTEXT_TOKENS=256000

# Sandbox's Python environment inside WSL
SANDBOX_VENV=
